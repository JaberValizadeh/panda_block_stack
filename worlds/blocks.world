<?xml version="1.0"?>
<!-- Table and three graspable blocks in front of the Panda.

     Geometry is fixed by the constants the dependent packages already carry
     (panda_voice_stack/scripts/voice_arm_control.py, panda_block_planner's
     geometry.py) - changing anything here without changing those breaks them:

       BLOCK        = 0.045                cube edge
       TABLE_SIZE   = (0.60, 0.90, 0.40)
       TABLE_CENTER = (0.55, 0.00, 0.20)   so the top surface is at z = 0.40
       HOME_XY      = A (0.45, -0.20), B (0.45, 0.20), C (0.62, 0.00)
       BLOCK_Z      = 0.40 + 0.045/2 = 0.4225

     Model names must be block_A / block_B / block_C: the nodes look blocks up in
     /gazebo/model_states by that exact name.

     Everything is defined inline rather than via model:// so the world loads
     offline. sun and ground_plane ship with Gazebo locally.

     Each block is a different colour - A red, B green, C blue - with a white
     letter on all six faces. Both come from one texture per block, under
     media/materials/ and made by tools/generate_assets.py, named here through
     <script>.

     Note what is NOT here: no <ambient>/<diffuse> next to those <script> tags.
     Stating a colour inline would be the robust way to keep the blocks tellable
     apart, but Gazebo applies inline colours ON TOP of the script material and
     OGRE multiplies the two - which turns a white glyph the exact hue of the face
     under it and makes it disappear. A white glyph therefore requires that the
     face colour live in the texture too, so it does.

     The consequence is that the <script> URIs matter for the colour and not just
     the letters. They are file:// paths, which Gazebo resolves against the
     entries of GAZEBO_RESOURCE_PATH: launch/environment.launch sets that on the
     Gazebo nodes and ~/moveit_ws/setup_env.bash exports it. Start gzserver on
     this world with neither and all three blocks come up plain white and
     identical, with

       [Err] URI doesn't exist[file://media/materials/scripts/blocks.material]

     in the log. That is the one failure mode to recognise here. -->
<!-- Reference: panda_sensor_stack/worlds/blocks_colored.world is this same scene
     with the letters left off, so that a colour segmenter has an unbroken hue to
     work with. Its fill light is copied in below for the same reason it exists
     there: the stock sun alone leaves the -y faces of the cubes dark enough to
     wash their hue out. -->
<sdf version="1.6">
  <world name="default">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- Fill light, straight down and dimmer than the sun, so every face of a
         cube shows its colour and its letter. Diffuse only: a specular highlight
         on a flat coloured face washes it out at the other end. -->
    <light name="fill" type="directional">
      <pose>0.55 0 3 0 0 0</pose>
      <direction>0 0 -1</direction>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0 0 0 1</specular>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Slower than realtime hurts nothing here and keeps the grasp stable. -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <model name="table">
      <static>true</static>
      <pose>0.55 0 0.20 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.60 0.90 0.40</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.60 0.90 0.40</size></box></geometry>
          <material>
            <ambient>0.35 0.25 0.15 1</ambient>
            <diffuse>0.55 0.40 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 45 mm cubes, 50 g. Light enough that the Panda's simulated fingers hold
         them, heavy enough not to be flicked away by contact noise. High
         friction because gazebo_grasp_fix only attaches once it has seen
         opposing contact forces for several update cycles. -->
    <model name="block_A">
      <pose>0.45 -0.20 0.4225 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.6875e-05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1.6875e-05</iyy><iyz>0</iyz><izz>1.6875e-05</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.045 0.045 0.045</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>2.0</mu><mu2>2.0</mu2></ode>
            </friction>
            <contact><ode><kp>1e6</kp><kd>100</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.045 0.045 0.045</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/blocks.material</uri>
              <uri>file://media/materials/textures</uri>
              <name>Blocks/A</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <model name="block_B">
      <pose>0.45 0.20 0.4225 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.6875e-05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1.6875e-05</iyy><iyz>0</iyz><izz>1.6875e-05</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.045 0.045 0.045</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>2.0</mu><mu2>2.0</mu2></ode>
            </friction>
            <contact><ode><kp>1e6</kp><kd>100</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.045 0.045 0.045</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/blocks.material</uri>
              <uri>file://media/materials/textures</uri>
              <name>Blocks/B</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <model name="block_C">
      <pose>0.62 0.00 0.4225 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.6875e-05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1.6875e-05</iyy><iyz>0</iyz><izz>1.6875e-05</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.045 0.045 0.045</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>2.0</mu><mu2>2.0</mu2></ode>
            </friction>
            <contact><ode><kp>1e6</kp><kd>100</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.045 0.045 0.045</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/blocks.material</uri>
              <uri>file://media/materials/textures</uri>
              <name>Blocks/C</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
