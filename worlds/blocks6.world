<?xml version="1.0"?>
<!-- Table and six graspable blocks in front of the Panda.

     blocks5.world with block_F added, for panda_block_planner's `six_blocks`
     scenario. Same reasoning as that file: a third world rather than more
     models in the others, because everything else that loads them names the
     blocks it expects and looks them up in /gazebo/model_states by name.

     KEEP IN STEP WITH blocks.world and blocks5.world. Everything below except
     the extra <model> blocks is copied, and the geometry is pinned by
     constants the dependent packages carry:

       BLOCK        = 0.045                cube edge
       TABLE_SIZE   = (0.60, 0.90, 0.40)
       TABLE_CENTER = (0.55, 0.00, 0.20)   so the top surface is at z = 0.40
       BLOCK_Z      = 0.40 + 0.045/2 = 0.4225

     Spawn poses do not matter much: panda_block_planner teleports every block
     to its scenario layout before planning (scene_setup.place_scenario), and
     parks the ones a scenario does not use on the strip at x = 0.78. They are
     laid out so the scene is sane if nothing ever moves them.

     Model names must be block_A ... block_F: the nodes look blocks up in
     /gazebo/model_states by that exact name.

     Colours are A red, B green, C blue, D orange, E violet, F teal, each with
     a white letter on all six faces, from one texture per block under
     media/materials/ and made by tools/generate_assets.py. See blocks.world
     for why the colour has to live in the texture rather than in an
     <ambient>/<diffuse> here, and for the GAZEBO_RESOURCE_PATH those file://
     URIs are resolved against. -->
<sdf version="1.6">
  <world name="default">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- Fill light, straight down and dimmer than the sun, so every face of a
         cube shows its colour and its letter. Diffuse only: a specular highlight
         on a flat coloured face washes it out at the other end. -->
    <light name="fill" type="directional">
      <pose>0.55 0 3 0 0 0</pose>
      <direction>0 0 -1</direction>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0 0 0 1</specular>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Slower than realtime hurts nothing here and keeps the grasp stable. -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <model name="table">
      <static>true</static>
      <pose>0.55 0 0.20 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.60 0.90 0.40</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.60 0.90 0.40</size></box></geometry>
          <material>
            <ambient>0.35 0.25 0.15 1</ambient>
            <diffuse>0.55 0.40 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 45 mm cubes, 50 g. Light enough that the Panda's simulated fingers hold
         them, heavy enough not to be flicked away by contact noise. High
         friction because gazebo_grasp_fix only attaches once it has seen
         opposing contact forces for several update cycles. -->
    <model name="block_A">
      <pose>0.45 -0.20 0.4225 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.6875e-05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1.6875e-05</iyy><iyz>0</iyz><izz>1.6875e-05</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.045 0.045 0.045</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>2.0</mu><mu2>2.0</mu2></ode>
            </friction>
            <contact><ode><kp>1e6</kp><kd>100</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.045 0.045 0.045</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/blocks.material</uri>
              <uri>file://media/materials/textures</uri>
              <name>Blocks/A</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <model name="block_B">
      <pose>0.45 0.20 0.4225 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.6875e-05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1.6875e-05</iyy><iyz>0</iyz><izz>1.6875e-05</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.045 0.045 0.045</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>2.0</mu><mu2>2.0</mu2></ode>
            </friction>
            <contact><ode><kp>1e6</kp><kd>100</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.045 0.045 0.045</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/blocks.material</uri>
              <uri>file://media/materials/textures</uri>
              <name>Blocks/B</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <model name="block_C">
      <pose>0.62 0.00 0.4225 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.6875e-05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1.6875e-05</iyy><iyz>0</iyz><izz>1.6875e-05</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.045 0.045 0.045</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>2.0</mu><mu2>2.0</mu2></ode>
            </friction>
            <contact><ode><kp>1e6</kp><kd>100</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.045 0.045 0.045</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/blocks.material</uri>
              <uri>file://media/materials/textures</uri>
              <name>Blocks/C</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <model name="block_D">
      <pose>0.62 -0.28 0.4225 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.6875e-05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1.6875e-05</iyy><iyz>0</iyz><izz>1.6875e-05</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.045 0.045 0.045</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>2.0</mu><mu2>2.0</mu2></ode>
            </friction>
            <contact><ode><kp>1e6</kp><kd>100</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.045 0.045 0.045</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/blocks.material</uri>
              <uri>file://media/materials/textures</uri>
              <name>Blocks/D</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <model name="block_E">
      <pose>0.62 0.28 0.4225 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.6875e-05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1.6875e-05</iyy><iyz>0</iyz><izz>1.6875e-05</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.045 0.045 0.045</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>2.0</mu><mu2>2.0</mu2></ode>
            </friction>
            <contact><ode><kp>1e6</kp><kd>100</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.045 0.045 0.045</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/blocks.material</uri>
              <uri>file://media/materials/textures</uri>
              <name>Blocks/E</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <model name="block_F">
      <pose>0.70 0.00 0.4225 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.6875e-05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1.6875e-05</iyy><iyz>0</iyz><izz>1.6875e-05</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.045 0.045 0.045</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>2.0</mu><mu2>2.0</mu2></ode>
            </friction>
            <contact><ode><kp>1e6</kp><kd>100</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.045 0.045 0.045</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/blocks.material</uri>
              <uri>file://media/materials/textures</uri>
              <name>Blocks/F</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
