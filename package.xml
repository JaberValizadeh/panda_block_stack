<?xml version="1.0"?>
<package format="2">
  <name>panda_block_stack</name>
  <version>0.1.0</version>
  <description>
    Gazebo scene for the Panda blocks demos: table, blocks A/B/C, and the Panda
    with gazebo_grasp_fix, ros_control and MoveIt. Supplies the environment that
    panda_voice_stack and panda_block_planner drive.
  </description>
  <maintainer email="valizadeh.au@gmail.com">jaber</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_grasp_plugin</exec_depend>
  <exec_depend>franka_description</exec_depend>
  <exec_depend>franka_gazebo</exec_depend>
  <exec_depend>franka_gripper</exec_depend>
  <exec_depend>panda_moveit_config</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>effort_controllers</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>moveit_commander</exec_depend>
  <exec_depend>moveit_ros_planning_interface</exec_depend>
  <exec_depend>actionlib</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf</exec_depend>
</package>
